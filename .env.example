# Massive market data (from the #massive Discord channel)
MASSIVE_API_KEY=
# Equity quotes (free key at finnhub.io)
FINNHUB_API_KEY=
# Impact model
ANTHROPIC_API_KEY=
# AI pipeline readers (never decide trades; every field is checked against the rule parser).
# Order when keys are present: OpenAI -> Gemini -> rules. LLM_PROVIDER=openai|gemini|rules|auto (default auto).
# OPENAI_MODEL must be listed by GET /v1/models for the key (make openai-check); unset = newest general model listed.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: Kalshi WebSocket (falls back to 1 Hz REST polling without these)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Required when the backend is tunnelled for the ElevenLabs voice agent (see docs/voice-agent.md)
AGENT_TOOL_SECRET=
